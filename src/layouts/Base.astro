---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "$config";
import App from "$layouts/App.astro";
import Navigator from "$layouts/header/Navigator.svelte";
import Footer from "$layouts/Footer.astro";
import Tip from "$components/Tip.svelte";
import "$styles/global.css";
import "$styles/markdown.css";
import "medium-zoom/dist/style.css";
import "katex/dist/katex.min.css";

let route = Astro.url.pathname;

const { locale = config.i18n.defaultLocale, title: subtitle, description = config.description, article } = Astro.props;
const title = config.title;
---

<script>
	import zoom from "medium-zoom/dist/pure";
	import Time from "$utils/time";
	import { renderMermaid } from "$utils/mermaid";

	// Set the `title` attribute of all `<time>` elements to localized date-time strings
	const localizeTimes = () => document.querySelectorAll("time").forEach(time => time.dateTime && (time.title = Time.locale(time.dateTime, navigator.language, Time.userTimezone)));

	// Add zoom effect to images within markdown content.
	// Every zoom() call creates a new instance, and each instance registers
	// document-level listeners that are never removed. Create the instance
	// once, then attach the images of the current page after each navigation.
	// attach skips images it already handles, so no detach is needed.
	window.zoom = () => {
		const zoomInstance = window.__mediumZoom ?? (window.__mediumZoom = zoom());
		zoomInstance.attach(".markdown img:not([data-nozoom])");
		zoomInstance.update({ background: "#00000044" });
	};

	// Page initialization function
	function initialize() {
		localizeTimes();
		window.zoom();
		renderMermaid();
	}

	// Execute initialization on first load
	initialize();

	// swup re-inserts this script on every navigation, so it runs again and
	// again. Register the listeners once and let later runs replace the
	// implementation instead of adding another listener.
	const registry = (window.__baseRegistry ??= { init: initialize, bound: false });
	registry.init = initialize;

	if (!registry.bound) {
		registry.bound = true;

		// swup dispatches astro:page-load on every navigation. The other
		// events this script used to listen for do not fire in swup 4.
		document.addEventListener("astro:page-load", () => registry.init());
	}
</script>

<App {locale} {title} {subtitle} {description} {article} author={config.author.name}>
	<Tip client:load />
	<div class="flex flex-col mx-auto *:*:px-3 w-[min(100%,1000px)]">
		<div id="body" class="flex flex-col min-h-screen">
			<header class="sticky top-0 flex items-center justify-between pt-3 pb-1 mb-4 bg-background z-4 sm:static sm:mb-12">
				<a href={getRelativeLocaleUrl(locale)} class="text-lg sm:text-2xl font-bold">{title}</a>
				<Navigator {locale} {route} client:load />
			</header>

			<slot />
		</div>

		<Footer {locale} author={config.author} copyright={config.copyright} />
	</div>
</App>

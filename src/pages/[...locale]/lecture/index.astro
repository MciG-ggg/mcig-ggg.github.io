---
import { getCollection } from "astro:content";
import config, { monolocale } from "$config";
import Base from "$layouts/Base.astro";
import Note from "$components/Note.svelte";
import i18nit from "$i18n";

export async function getStaticPaths() {
	// Create path for each locale, omitting default locale from URL
	return config.i18n.locales.map(locale => ({ params: { locale: config.i18n.defaultLocale === locale ? undefined : locale } }));
}

const { locale = config.i18n.defaultLocale } = Astro.params;

const t = i18nit(locale);

const lectures = await getCollection("lecture", lecture => {
	// Filter by publication status and locale
	let published = !lecture.data.draft;
	let localed = monolocale || lecture.id.split("/")[0] === locale;

	return published && localed;
});

// Standardize lecture structure
let list = lectures.map(lecture => ({
	id: lecture.id,
	data: {
		title: lecture.data.title,
		timestamp: lecture.data.timestamp,
		series: lecture.data.series,
		tags: lecture.data.tags,
		sensitive: lecture.data.sensitive,
		top: lecture.data.top
	}
}));

// Extract all unique series and tags from the filtered lectures
const series = Array.from(new Set(lectures.map(lecture => lecture.data.series).filter((item): item is string => Boolean(item)))).sort();
const tags = Array.from(new Set(lectures.flatMap(lecture => lecture.data.tags ?? []))).sort();
---

<Base title={t("navigation.lecture")} {locale}>
	<main class="flex flex-col grow">
		<Note client:load {locale} notes={list} {series} {tags} base="/lecture" />
	</main>
</Base>
